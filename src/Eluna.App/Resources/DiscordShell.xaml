  <Style x:Key="RoomGlyph" TargetType="Path"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Stroke" Value="{DynamicResource MutedBrush}" /><Setter Property="StrokeThickness" Value="1.6" /><Setter Property="Data" Value="{StaticResource HashIcon}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="voice"><Setter Property="Data" Value="{StaticResource VolumeIcon}" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="dm"><Setter Property="Data" Value="{StaticResource ChatIcon}" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="group"><Setter Property="Data" Value="{StaticResource ChatIcon}" /></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="thread"><Setter Property="Data" Value="{StaticResource ChatIcon}" /></DataTrigger></Style.Triggers></Style>
  <Style x:Key="ShellIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="7" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" />
