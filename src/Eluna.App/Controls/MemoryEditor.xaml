<UserControl x:Class="Eluna.App.Controls.MemoryEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12">
      <Button Content="＋ メモリを追加" Click="Add_Click" BorderBrush="{DynamicResource StrokeBrush}" Margin="0,0,8,8" />
      <Button x:Name="EditButton" Content="編集" Click="Edit_Click" IsEnabled="False" Margin="0,0,8,8" />
      <Button x:Name="RemoveButton" Content="削除" Click="Remove_Click" IsEnabled="False" Margin="0,0,0,8" />
    </WrapPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <ListBox x:Name="NotesList" SelectionChanged="Selection_Changed" AutomationProperties.Name="保存メモリの一覧">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}" /></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="保存メモリはまだありません。&#10;「＋ メモリを追加」から登録できます。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="10" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=NotesList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <TextBox x:Name="MemoryText" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="選択した保存メモリの内容" />
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Text="自動では記憶しません。追加・編集・削除は、親画面の「保存」で反映します。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
  </Grid>
</UserControl>
