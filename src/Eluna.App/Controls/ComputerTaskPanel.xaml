<UserControl x:Class="Eluna.App.Controls.ComputerTaskPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,5,0,10">
    <StackPanel>
      <DockPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding ModelName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" HorizontalAlignment="Right" Margin="8,0,0,0" /></DockPanel>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Stage}" Value="complete"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <WrapPanel Margin="0,0,0,6">
        <Button Content="一時停止" Tag="pause" Click="Command_Click" Visibility="{Binding CanPause, Converter={StaticResource BoolVisibility}}" Padding="10,6" />
        <Button Content="自分で操作" Tag="takeover" Click="Command_Click" Visibility="{Binding CanPause, Converter={StaticResource BoolVisibility}}" Padding="10,6" />
        <Button Content="最新画面から再開" Tag="resume" Click="Command_Click" Visibility="{Binding CanResume, Converter={StaticResource BoolVisibility}}" Padding="10,6" />
        <Button Content="停止 · Ctrl+Alt+Esc" Tag="stop" Click="Command_Click" Visibility="{Binding Pending, Converter={StaticResource BoolVisibility}}" Padding="10,6" />
      </WrapPanel>
      <StackPanel Visibility="{Binding Selecting, Converter={StaticResource BoolVisibility}}">
        <ListBox ItemsSource="{Binding Windows}" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="操作を許可するアプリ">
          <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" HorizontalContentAlignment="Stretch" ToolTip="{Binding Label}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></CheckBox></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,6,0,6"><Button Content="許可して続行" Tag="allow" Click="Command_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Padding="10,6" /><Button Content="アプリを更新" Tag="refresh" Click="Command_Click" Padding="10,6" /></WrapPanel>
        <TextBlock Text="対象アプリを表示してください。このWindowsセッションのマウスとキーボードを共有します。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
        <Expander Header="アプリを起動する" Foreground="{DynamicResource TextBrush}" Margin="0,5"><StackPanel><ComboBox ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" DisplayMemberPath="Name" IsTextSearchEnabled="True" AutomationProperties.Name="起動するWindowsアプリ" /><Button Content="選んだアプリを起動" Tag="launch" Click="Command_Click" HorizontalAlignment="Left" Padding="10,6" Margin="0,5" /></StackPanel></Expander>
      </StackPanel>
      <CheckBox Content="マウス・キーボードを自動操作" IsChecked="{Binding Automatic}" Margin="0,5,0,5" ToolTip="通常の操作を自動実行します。送信・購入・削除等は確認します。オフでは各操作を確認します。" Visibility="{Binding Pending, Converter={StaticResource BoolVisibility}}" />
      <Expander Header="作業計画" Foreground="{DynamicResource TextBrush}" Margin="0,4"><TextBlock Text="{Binding Plan}" TextWrapping="Wrap" FontSize="12" Margin="0,6" /></Expander>
      <Expander Header="操作プレビュー" Foreground="{DynamicResource TextBrush}" Margin="0,4">
        <Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="True" /><Style.Triggers><DataTrigger Binding="{Binding Stage}" Value="complete"><Setter Property="IsExpanded" Value="False" /></DataTrigger></Style.Triggers></Style></Expander.Style>
        <StackPanel><TextBlock Text="{Binding WindowHint}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4" />
          <Grid x:Name="Viewport" Background="Black" MaxHeight="190" SizeChanged="Viewport_SizeChanged"><Image x:Name="ScreenImage" Source="{Binding Preview}" MaxHeight="190" Stretch="Uniform" AutomationProperties.Name="最後に取得した対象アプリの画面" /><Canvas x:Name="Markers" IsHitTestVisible="False" /></Grid>
        </StackPanel>
      </Expander>
      <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8" Visibility="{Binding Reviewing, Converter={StaticResource BoolVisibility}}">
        <StackPanel><TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" FontSize="12" />
          <TextBox Text="{Binding ReviewInput, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,8,0,5" MaxLength="8000" Visibility="{Binding ReviewIsText, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="実行する入力文字・修正できます" />
          <WrapPanel><Button x:Name="ApproveButton" Content="この操作を実行" Tag="approve" Click="Command_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Padding="10,6" /><Button Content="実行せず停止" Tag="deny" Click="Command_Click" Padding="10,6" /></WrapPanel>
        </StackPanel>
      </Border>
      <Expander Header="操作履歴" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0"><ListBox ItemsSource="{Binding Steps}" MaxHeight="190" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Computer Useの操作履歴"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Action.Label}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Action.Reason}" TextWrapping="Wrap" FontSize="12" /><TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
    </StackPanel>
  </Border>
</UserControl>
