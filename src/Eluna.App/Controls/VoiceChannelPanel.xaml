<UserControl x:Class="Eluna.App.Controls.VoiceChannelPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="{Binding ShowVoicePanel, Converter={StaticResource BoolVisibility}}">
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="12,8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="230">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Click="Open_Click" HorizontalContentAlignment="Left" Padding="0,2" FontWeight="SemiBold" FontSize="14" MaxWidth="160" ToolTip="{Binding VoiceRoomName}"><TextBlock Text="{Binding VoiceRoomName}" TextTrimming="CharacterEllipsis" /></Button><TextBlock Grid.Column="1" Text="{Binding VoiceStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VoiceStatus}" VerticalAlignment="Center" FontSize="12" Margin="12,0" /><Button x:Name="JoinButton" Grid.Column="2" Content="参加する" Click="Join_Click" Padding="12,6" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Visibility="{Binding CanJoinVoiceChannel, Converter={StaticResource BoolVisibility}}" /></Grid>
        <ItemsControl ItemsSource="{Binding VoiceParticipants}" Margin="0,6,0,0" AutomationProperties.Name="現在のボイス参加者"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,6,6"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,6,0" /><StackPanel><TextBlock Text="{Binding Name}" MaxWidth="150" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="12" /><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel Margin="0,6,0,0" Visibility="{Binding VoiceJoined, Converter={StaticResource BoolVisibility}}">
          <Button Content="参加者を選ぶ" Click="Participants_Click" Padding="9,5" Margin="0,0,6,6" /><Button x:Name="MicrophoneButton" Content="{Binding MicrophoneLabel}" Click="Microphone_Click" Padding="9,5" Margin="0,0,6,6" /><Button Content="割り込んで話す" Click="Interrupt_Click" Padding="9,5" Margin="0,0,6,6" /><Button Content="{Binding VoiceOutputLabel}" Click="Output_Click" Padding="9,5" Margin="0,0,6,6" />
          <Button x:Name="ShareButton" Content="画面を共有" Click="Share_Click" Padding="9,5" Margin="0,0,6,6" /><Button Content="共有を終了" Click="StopShare_Click" Padding="9,5" Margin="0,0,6,6" Visibility="{Binding IsSharing, Converter={StaticResource BoolVisibility}}" /><Button Content="退出" Click="Leave_Click" Padding="9,5" Margin="0,0,0,6" />
        </WrapPanel>
        <Border Visibility="{Binding IsSharing, Converter={StaticResource BoolVisibility}}" Padding="8" Background="{DynamicResource SurfaceBrush}" CornerRadius="5" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition /></Grid.ColumnDefinitions><Image Source="{Binding SharedPreview}" Stretch="Uniform" MaxHeight="96" /><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding SharedTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SharedTitle}" /><TextBlock Text="{Binding ShareStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,3" /><CheckBox x:Name="ControlBox" IsChecked="{Binding ShareControlAllowed}" Margin="0,4,0,0"><TextBlock Text="この画面でAIの操作を許可" TextWrapping="Wrap" FontSize="12" /></CheckBox></StackPanel></Grid></Border>
        <TextBox Text="{Binding VoiceHeard, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" MaxHeight="52" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="音声の認識結果"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding VoiceHeard}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
        <TextBlock Text="{Binding VoiceNotice}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
