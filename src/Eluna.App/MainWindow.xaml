<Window x:Class="Eluna.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eluna.App.Controls"
        Style="{StaticResource {x:Type Window}}" Title="Eluna" Width="1280" Height="900"
        MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" Language="ja-JP">
  <Grid x:Name="RootLayout">
    <Grid.ColumnDefinitions><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="52" /><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="208" /><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource BackgroundBrush}" Visibility="{Binding SidebarVisible, Converter={StaticResource BoolVisibility}}" Padding="3,10">
      <DockPanel><Button DockPanel.Dock="Bottom" Content="＋" Click="ProjectMenu_Click" ToolTip="サーバーの作成・管理" AutomationProperties.Name="サーバーの作成・管理" Margin="0,6,0,0" />
        <ListBox x:Name="ServerList" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProjectChoice}" AutomationProperties.Name="サーバーとDM">
          <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Width="36" Height="36" ToolTip="{Binding Name}" Margin="0,3"><TextBlock Text="{Binding Icon}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" Padding="10,10,10,10" Visibility="{Binding SidebarVisible, Converter={StaticResource BoolVisibility}}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="4,0,0,8" Height="32"><Button DockPanel.Dock="Right" Content="エージェント" Click="Agents_Click" Padding="6,4" FontSize="11" AutomationProperties.Name="エージェントの管理" /><TextBlock Text="Eluna" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <StackPanel Grid.Row="1">
        <Button Click="NewRoom_Click" IsEnabled="{Binding CanNavigate}" HorizontalContentAlignment="Left"
                BorderBrush="{DynamicResource StrokeBrush}" Margin="0,0,0,6" AutomationProperties.Name="チャンネルまたはDMを作成">
          <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="18" Margin="0,0,8,0" /><TextBlock Text="チャンネル・DM" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <DockPanel Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Content="⋯" Click="ProjectMenu_Click" Padding="8,6" Margin="4,0,0,0" IsEnabled="{Binding CanChange}" ToolTip="プロジェクトの作成・管理" AutomationProperties.Name="プロジェクトの作成・管理" />
          <ComboBox x:Name="ProjectSelector" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProjectChoice}" ItemTemplate="{StaticResource ProjectNameTemplate}" IsEnabled="{Binding CanCompose}" AutomationProperties.Name="表示するプロジェクト" />
        </DockPanel>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
          <DockPanel Margin="10,0,0,10"><CheckBox DockPanel.Dock="Right" Content="保管済み" IsChecked="{Binding ShowArchived}" FontSize="11" HorizontalAlignment="Right" /><TextBlock Text="チャンネル・DM" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></DockPanel>
          <Grid Grid.Row="1"><TextBox x:Name="HistorySearchBox" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="履歴を全文検索（Ctrl+F）" AutomationProperties.Name="履歴を検索" Margin="0,0,0,12" /><TextBlock Text="履歴を検索" Foreground="{DynamicResource MutedBrush}" Margin="10,9,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding HistoryView}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" SelectedItem="{Binding SelectedConversation}"
                   IsEnabled="{Binding CanCompose}" AutomationProperties.Name="会話履歴">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,8,0,3" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
                  <StackPanel ToolTip="{Binding Title}"><TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="13"><Run Text="{Binding PinLabel, Mode=OneWay}" /><Run Text="{Binding NavigationLabel, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding HistoryDetail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding SearchExcerpt}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SearchExcerpt}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                  <Button Grid.Column="1" Content="⋯" Padding="4,0" Foreground="{DynamicResource MutedBrush}" Click="HistoryMenu_Click" ToolTip="会話の操作" AutomationProperties.Name="会話の操作" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox><TextBlock Grid.Row="2" Text="{Binding HistoryEmptyHint}" TextWrapping="Wrap" Margin="8,12" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistoryView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <StackPanel Grid.Row="3">
          <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6" /></Style></StackPanel.Resources>
          <ToggleButton x:Name="ProcessButton" Style="{StaticResource ModeToggle}" HorizontalContentAlignment="Stretch" Padding="10,7" AutomationProperties.Name="処理リスト" ToolTip="推論・ダウンロード・作成の進捗と予約順">
            <DockPanel><TextBlock Text="処理リスト" /><TextBlock Text="{Binding ProcessSummary}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="8,0,0,0" /></DockPanel>
          </ToggleButton>
          <Popup x:Name="ProcessPopup" PlacementTarget="{Binding ElementName=ProcessButton}" Placement="Right" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=ProcessButton, Mode=TwoWay}" Opened="ProcessPopup_Opened">
            <Border Width="420" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10"><ContentControl x:Name="ProcessContent" /></Border>
          </Popup>
          <Button Click="Settings_Click" IsEnabled="{Binding CanCompose}" HorizontalContentAlignment="Left">
            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Margin="0,0,12,0" /><TextBlock Text="設定" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="2" Background="{DynamicResource ChatBackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid x:Name="HeaderArea" Margin="20,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Content="☰" Click="Sidebar_Click" Padding="8,7" Margin="0,0,10,0" ToolTip="サイドバーを切り替え" />
        <ComboBox Grid.Column="1" x:Name="ModelSelector" MinWidth="160" MaxWidth="380" HorizontalAlignment="Left" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" ItemTemplate="{StaticResource ModelNameTemplate}" IsEnabled="{Binding CanCompose}" SelectionChanged="AgentModel_Changed" ToolTip="宛先エージェントの使用モデル" AutomationProperties.Name="使用するモデル" Visibility="{Binding HasModel, Converter={StaticResource BoolVisibility}}" />
        <Button Grid.Column="1" Content="モデルを選ぶ  ⌄" Click="Models_Click" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" IsEnabled="{Binding CanCompose}">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button Grid.Column="3" Content="＋" FontSize="20" Click="Models_Click" IsEnabled="{Binding CanCompose}" Padding="10,4" Margin="10,0,0,0" ToolTip="モデルを追加" AutomationProperties.Name="モデルを追加" />
        <Button Grid.Column="2" Content="⋯" Click="ChatMenu_Click" Padding="10,4" FontSize="20" IsEnabled="{Binding CanCompose}" ToolTip="会話とモデルの操作" /><ComboBox Grid.Row="2" Grid.Column="1" x:Name="BranchSelector" AutomationProperties.Name="会話の分岐" ItemTemplate="{StaticResource BranchNameTemplate}" ItemsSource="{Binding SelectedConversation.Branches}" SelectedItem="{Binding SelectedBranch, Mode=OneWay}" SelectionChanged="Branch_SelectionChanged" MaxWidth="240" HorizontalAlignment="Left" Margin="0,8,0,0" IsEnabled="{Binding CanCompose}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedConversation.Branches.Count}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,5,0,0">
          <ComboBox x:Name="RecipientSelector" DockPanel.Dock="Right" ItemsSource="{Binding Recipients}" SelectedItem="{Binding SelectedRecipient}" DisplayMemberPath="Name" MaxWidth="180" MinWidth="110" Padding="6,3" FontSize="11" AutomationProperties.Name="メッセージの宛先" />
          <Button Click="RoomSettings_Click" HorizontalContentAlignment="Left" Padding="0,4,8,0" ToolTip="{Binding ProjectScopeHint}" AutomationProperties.Name="チャンネルと参照範囲"><TextBlock Text="{Binding RoomLabel}" TextTrimming="CharacterEllipsis" FontSize="12" /></Button>
        </DockPanel>
        <Popup x:Name="ModePopup" PlacementTarget="{Binding ElementName=ModeButton}" Placement="Top" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=ModeButton, Mode=TwoWay}">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="16" Width="320" Padding="10">
            <StackPanel>
              <TextBlock Text="思考量" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,8,0,8" />
              <ListBox x:Name="ModeList" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}" SelectionChanged="Mode_SelectionChanged" AutomationProperties.Name="思考量" KeyboardNavigation.TabNavigation="Cycle">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontSize="21" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
                    <TextBlock Grid.Column="2" Text="✓" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVisibility}}" />
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="12,10" />
              <TextBlock Text="思考量の変更は、対応モデルで有効です。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,12,6" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="8" Margin="20,0,20,6" Padding="14,10" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="64" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="エラーの詳細" />
          <Button Grid.Column="1" Content="再試行" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" Margin="8,0" /><Button Grid.Column="2" Content="×" Padding="5" Click="DismissError_Click" AutomationProperties.Name="エラー表示を閉じる" />
        </Grid>
      </Border>
      <Grid Grid.Row="2">
        <ListBox x:Name="MessagesList" ItemsSource="{Binding Timeline}" Margin="0,8,0,12" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="MessageBorder" Background="Transparent" Padding="20,6" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                      <TextBlock x:Name="AvatarLetter" Text="{Binding Avatar}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel x:Name="Speaker" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Speaker}" FontSize="13" FontWeight="SemiBold" />
                        <Border x:Name="AssistantBadge" Background="#5865F2" CornerRadius="3" Padding="4,1" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock Text="AI" Foreground="White" FontSize="9" FontWeight="SemiBold" /></Border>
                        <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,3,0,0" />
                        <TextBlock Text="{Binding SpeakerDetail}" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTip="{Binding SpeakerDetail}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="7,3,0,0" />
                      </StackPanel>
                      <StackPanel x:Name="MessageActions" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                        <Button Content="↩" ToolTip="この発言へ返信" Style="{StaticResource MessageAction}" Click="ReplyMessage_Click" /><Button Content="⋯" ToolTip="スレッドと発言の操作" Style="{StaticResource MessageAction}" Click="MessageMenu_Click" />
                        <Button Content="コピー" Style="{StaticResource MessageAction}" Click="CopyMessage_Click" />
                        <StackPanel x:Name="AnswerActions" Orientation="Horizontal" IsEnabled="{Binding DataContext.CanEditConversation, RelativeSource={RelativeSource AncestorType=Window}}">
                          <Button Content="再生成" ToolTip="{Binding DataContext.EditConversationHint, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MessageAction}" Click="Regenerate_Click" />
                          <Button Content="続きを生成" ToolTip="{Binding DataContext.EditConversationHint, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MessageAction}" Click="Continue_Click" />
                        </StackPanel>
                        <Button x:Name="EditAction" Content="編集" Style="{StaticResource MessageAction}" Click="EditMessage_Click" Visibility="Collapsed" IsEnabled="{Binding DataContext.CanEditConversation, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </StackPanel>
                    </Grid>
                    <Button Content="{Binding ReplyPreview}" Click="JumpReply_Click" HorizontalContentAlignment="Left" Padding="0,3" FontSize="11" MaxHeight="28" Visibility="{Binding HasReply, Converter={StaticResource BoolVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding HasThought, Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="◌" FontSize="17" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                      <TextBlock Text="{Binding ThinkingLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="13" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <TextBlock Text="応答を準備しています…" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="{Binding Work.Label}" Click="WorkActivity_Click" HorizontalAlignment="Left" BorderBrush="{DynamicResource StrokeBrush}" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding HasWork, Converter={StaticResource BoolVisibility}}" ToolTip="調査の活動と資料を開く" AutomationProperties.Name="調査の活動と資料" />
                    <controls:MarkdownView x:Name="MarkdownBody" ReferenceClicked="Reference_Clicked" Markdown="{Binding Content}" TextSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=Window}}" TextLineHeight="{Binding DataContext.ChatLineHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <controls:ComputerTaskPanel Session="{Binding Computer}" />
                    <controls:DebateTaskPanel Work="{Binding Work}" Chat="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{Binding ArtifactLabel}" Click="OpenArtifact_Click" HorizontalAlignment="Left" Margin="0,6,0,0" BorderBrush="{DynamicResource StrokeBrush}" Visibility="{Binding HasArtifact, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="{Binding KnowledgeLabel}" Click="Knowledge_Click" HorizontalAlignment="Left" Padding="8,6" Margin="0,8,0,0" BorderBrush="{DynamicResource StrokeBrush}" Visibility="{Binding HasKnowledge, Converter={StaticResource BoolVisibility}}" ToolTip="この回答の生成時にAIへ渡した抜粋を確認" />
                    <Button Content="{Binding SkillsLabel}" Click="SkillUse_Click" HorizontalAlignment="Left" Padding="8,6" Margin="0,8,0,0" BorderBrush="{DynamicResource StrokeBrush}" Visibility="{Binding HasSkills, Converter={StaticResource BoolVisibility}}" ToolTip="使用した手順・資料・補助コードの実行記録" />
<TextBox x:Name="UserBody" Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Padding="0" Background="Transparent" Visibility="Collapsed" FontSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=Window}}" TextBlock.LineHeight="{Binding DataContext.ChatLineHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate><Button Click="AttachmentPreview_Click" Margin="0,0,8,8" BorderBrush="{DynamicResource StrokeBrush}" ToolTip="添付内容を開く"><StackPanel><Image Source="{Binding Preview}" MaxWidth="220" MaxHeight="150" Stretch="Uniform" /><TextBlock Text="{Binding Label}" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,5,0,0" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasComputer}" Value="True"><Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /></DataTrigger>
                  <DataTrigger Binding="{Binding SearchHighlighted}" Value="True"><Setter TargetName="MessageBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="MessageBorder" Property="BorderThickness" Value="1" /></DataTrigger>
                  <Trigger SourceName="MessageBorder" Property="IsMouseOver" Value="True"><Setter TargetName="MessageBorder" Property="Background" Value="{DynamicResource ChatHoverBrush}" /><Setter TargetName="MessageActions" Property="Opacity" Value="1" /></Trigger>
                  <Trigger SourceName="MessageBorder" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="MessageActions" Property="Opacity" Value="1" /></Trigger>
                  <DataTrigger Binding="{Binding Role}" Value="user">
                    <Setter TargetName="Avatar" Property="Background" Value="#5865F2" /><Setter TargetName="AvatarLetter" Property="Text" Value="あ" /><Setter TargetName="AvatarLetter" Property="FontSize" Value="16" /><Setter TargetName="AvatarLetter" Property="Foreground" Value="White" />
                    <Setter TargetName="AssistantBadge" Property="Visibility" Value="Collapsed" /><Setter TargetName="MarkdownBody" Property="Visibility" Value="Collapsed" /><Setter TargetName="UserBody" Property="Visibility" Value="Visible" /><Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /><Setter TargetName="EditAction" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsProjection}" Value="True"><Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /><Setter TargetName="EditAction" Property="Visibility" Value="Collapsed" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
</ListBox><Button x:Name="LatestButton" Content="↓ 最新の回答" Click="Latest_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,32,12" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed" />
<ScrollViewer x:Name="WelcomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
        <StackPanel MaxWidth="660" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,24">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ChatInputBrush}" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="#" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="ここから会話が始まります" FontSize="28" FontWeight="SemiBold" TextAlignment="Left" Margin="0,0,0,12" />
          <TextBlock Text="考えを整理したり、文章を書いたり。あなたのPCで、一緒に。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" TextAlignment="Left" Margin="0,0,0,24" />
          <UniformGrid Columns="2">
            <Button Tag="新しいアイデアを一緒に整理してください。" Click="Suggestion_Click" BorderBrush="{DynamicResource StrokeBrush}" Margin="4" Padding="18,16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="✧  アイデアを整理する" /><TextBlock Text="思いつきを、具体的な一歩に" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Button>
            <Button Tag="文章を読みやすく整えるのを手伝ってください。" Click="Suggestion_Click" BorderBrush="{DynamicResource StrokeBrush}" Margin="4" Padding="18,16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="✎  文章を磨く" /><TextBlock Text="伝わる言葉を、一緒に探す" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Button>
            <Button Tag="コードについて相談したいです。" Click="Suggestion_Click" BorderBrush="{DynamicResource StrokeBrush}" Margin="4" Padding="18,16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⌘  コードを相談する" /><TextBlock Text="仕組みを理解して、前に進む" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Button>
            <Button Tag="難しい内容をわかりやすく説明してください。" Click="Suggestion_Click" BorderBrush="{DynamicResource StrokeBrush}" Margin="4" Padding="18,16" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="◎  わかりやすく学ぶ" /><TextBlock Text="気になることを、ひとつずつ" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Button>
          </UniformGrid>
          <Button Content="まずはモデルを探す" Click="Models_Click" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="24,12">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasModel}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
        </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="ComposerArea" Grid.Row="3" MaxWidth="1000" Margin="20,0,20,8" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Visibility="{Binding ShowStatus, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,3" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Metrics}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="4,0,0,3" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Metrics}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource ChatInputBrush}" CornerRadius="10" Padding="18,6,12,6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition MinHeight="48" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2"><Button Content="{Binding ReplyLabel}" Click="ClearReply_Click" Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="0,2" FontSize="11" />
            <ScrollViewer MaxHeight="48" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding PendingAttachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,8,2" Padding="6,2"><StackPanel Orientation="Horizontal"><Button Click="AttachmentPreview_Click" Padding="4" ToolTip="添付を確認"><TextBlock Text="{Binding Label}" MaxWidth="190" TextTrimming="CharacterEllipsis" /></Button><Button Content="×" Click="RemoveAttachment_Click" Padding="6,2" ToolTip="添付を外す" IsEnabled="{Binding DataContext.CanChange, RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
            </StackPanel>
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
              <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="160" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0,8" FontSize="14" VerticalContentAlignment="Top" PreviewKeyDown="Input_PreviewKeyDown" AutomationProperties.Name="メッセージを入力" />
              <TextBlock Text="メッセージを入力" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="0,12,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Input}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="-6,0,0,0">
              <Button Content="＋" Click="MediaMenu_Click" IsEnabled="{Binding CanCompose}" Padding="7,6" Margin="0,0,4,0" ToolTip="画像・文書を添付／作成" AutomationProperties.Name="画像・文書を添付または作成" />
              <ComboBox x:Name="WorkModeSelector" ItemsSource="{Binding WorkChoices}" SelectedItem="{Binding SelectedWorkMode}" ItemTemplate="{StaticResource WorkNameTemplate}" Width="172" IsEnabled="{Binding CanCompose}" ToolTip="通常は必要に応じて検索します。Web検索は必ず検索し、検索しないモードは外部の情報を取得しません。" AutomationProperties.Name="作業モード" Margin="0,0,4,0" />
            <ToggleButton x:Name="ModeButton" Style="{StaticResource ModeToggle}" HorizontalAlignment="Left" Padding="10,7" IsEnabled="{Binding CanCompose}" ToolTip="思考量を選ぶ" AutomationProperties.Name="思考量を選ぶ">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedMode.Icon}" FontSize="17" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SelectedMode.Name}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="⌄" Foreground="{DynamicResource MutedBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
              <Button x:Name="ComposerSkillsButton" Content="{Binding SkillsLabel}" Click="SkillPicker_Click" Padding="8,6" IsEnabled="{Binding CanCompose}" ToolTip="スキルの自動適用・指定・オフ" />
              <Button x:Name="ComposerWorkOptionsButton" Click="WorkOptions_Click" Padding="8,6" IsEnabled="{Binding CanCompose}" AutomationProperties.Name="検索・調査・議論の設定">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="⚙" /><Setter Property="ToolTip" Value="検索・調査・議論の上限と参加者" /><Style.Triggers><DataTrigger Binding="{Binding SelectedWorkMode.Id}" Value="debate"><Setter Property="Content" Value="参加者" /><Setter Property="ToolTip" Value="参加者とモデルをドラッグ＆ドロップで変更" /></DataTrigger></Style.Triggers></Style></Button.Style>
              </Button>
              <Button x:Name="ComposerMoreButton" Content="⋯" Click="ComposerMore_Click" Padding="8,6" Visibility="Collapsed" IsEnabled="{Binding CanCompose}" ToolTip="スキル・検索・調査・参加者の設定" AutomationProperties.Name="スキル・検索・調査・参加者の設定" />
            </WrapPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
              <Button Content="■" Command="{Binding StopCommand}" Padding="10,7" Margin="4,0,6,0" FontSize="13" ToolTip="{Binding StopTip}" AutomationProperties.Name="{Binding StopTip}" Visibility="{Binding CanStopSelected, Converter={StaticResource BoolVisibility}}" />
              <Button Content="↑" Command="{Binding SendCommand}" Style="{StaticResource ComposerAction}" ToolTip="{Binding SendLabel}" AutomationProperties.Name="{Binding SendLabel}" />
            </StackPanel>
          </Grid>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,5,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding SendTip}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding ConnectionNotice}" AutomationProperties.HelpText="{Binding NetworkNotice}" ToolTip="{Binding NetworkNotice}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></DockPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
