<Window x:Class="Eluna.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eluna.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="Eluna" Width="1280" Height="900" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen" Language="ja-JP" WindowStyle="None">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="MemberTemplate"><Button Click="Member_Click" HorizontalContentAlignment="Stretch" Background="Transparent" Padding="8,6" Margin="4,0" AutomationProperties.Name="{Binding Name}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left"><TextBlock Text="{Binding Icon}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" /><TextBlock Text="{Binding Specialty}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource MutedBrush}" /></StackPanel></Grid></Button></DataTemplate>
  </Window.Resources>
  <Grid><Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition /></Grid.RowDefinitions>
    <Grid Background="{DynamicResource BackgroundBrush}"><TextBlock Text="Eluna" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="14,0" FontSize="11" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource ShellIcon}" Width="38" Height="28" Content="─" Click="Minimize_Click" AutomationProperties.Name="最小化" /><Button Style="{StaticResource ShellIcon}" Width="38" Height="28" Content="□" Click="Maximize_Click" AutomationProperties.Name="最大化または元に戻す" /><Button Style="{StaticResource ShellIcon}" Width="38" Height="28" Content="×" Click="CloseWindow_Click" AutomationProperties.Name="ウィンドウを閉じる" /></StackPanel></Grid>
    <Grid x:Name="RootLayout" Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="72" /><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="224" /><Style.Triggers><DataTrigger Binding="{Binding SidebarVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource BackgroundBrush}" Padding="0,8,0,10" Visibility="{Binding SidebarVisible, Converter={StaticResource BoolVisibility}}"><DockPanel><Button DockPanel.Dock="Bottom" Content="＋" Click="ProjectMenu_Click" FontSize="27" Width="48" Height="48" Padding="0" Margin="12,8,12,0" Background="{DynamicResource SidebarBrush}" ToolTip="サーバーを追加・管理" AutomationProperties.Name="サーバーを追加・管理" /><ListBox x:Name="ServerList" ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProjectChoice}" ItemContainerStyle="{StaticResource ServerItem}" AutomationProperties.Name="サーバーとDM"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Icon}" FontSize="16" FontWeight="SemiBold" ToolTip="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" Visibility="{Binding SidebarVisible, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition /><RowDefinition Height="54" /></Grid.RowDefinitions>
        <Button x:Name="ServerMenuButton" Click="ProjectMenu_Click" Padding="16,0" HorizontalContentAlignment="Stretch" Background="Transparent" AutomationProperties.Name="サーバーメニュー"><DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding ServerTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></DockPanel></Button>
        <Grid Grid.Row="1" Margin="8,14,8,0"><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition /></Grid.RowDefinitions><DockPanel Margin="8,0,0,4"><Button DockPanel.Dock="Right" Content="＋" Click="NewRoom_Click" Style="{StaticResource ShellIcon}" Width="24" Height="24" Padding="3" ToolTip="チャンネルまたはDMを作成" AutomationProperties.Name="チャンネルまたはDMを作成" /><TextBlock Text="{Binding ChannelListHeading}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
          <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding HistoryView}" SelectedItem="{Binding SelectedConversation}" ItemContainerStyle="{StaticResource ChannelItem}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" IsEnabled="{Binding CanCompose}" AutomationProperties.Name="チャンネルとダイレクトメッセージ">
            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="8,14,0,4"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Name}" Value="チャンネル"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Name}" Value="DM"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
            <ListBox.ItemTemplate><DataTemplate><Grid x:Name="ChannelRow"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions><StackPanel ToolTip="{Binding Title}"><TextBlock Text="{Binding NavigationLabel}" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SearchExcerpt}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasHistorySearch, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Button x:Name="ChannelMenu" Grid.Column="1" Content="⋯" Click="HistoryMenu_Click" Padding="0" Width="20" Height="20" Opacity="0" ToolTip="チャンネルの操作" /></Grid><DataTemplate.Triggers><Trigger SourceName="ChannelRow" Property="IsMouseOver" Value="True"><Setter TargetName="ChannelMenu" Property="Opacity" Value="1" /></Trigger><Trigger SourceName="ChannelRow" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ChannelMenu" Property="Opacity" Value="1" /></Trigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
          </ListBox><TextBlock Grid.Row="1" Text="{Binding HistoryEmptyHint}" TextWrapping="Wrap" Margin="8,12" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistoryView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="8,6"><DockPanel><Button x:Name="UserSettingsButton" DockPanel.Dock="Right" Click="Settings_Click" Style="{StaticResource ShellIcon}" ToolTip="ユーザー設定" AutomationProperties.Name="ユーザー設定"><Path Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform" /></Button><Border Width="32" Height="32" CornerRadius="16" Background="#5865F2" DockPanel.Dock="Left" Margin="0,0,8,0"><TextBlock Text="{Binding Self.Icon}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><Button Click="SelfProfile_Click" Padding="0" Background="Transparent" HorizontalContentAlignment="Left"><TextBlock Text="{Binding Self.Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" /></Button><TextBlock Text="会話に参加中" FontSize="10" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DockPanel></Border>
      </Grid></Border>
      <Grid Grid.Column="2" Background="{DynamicResource ChatBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="48" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
        <Border x:Name="HeaderArea" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Style="{StaticResource ShellIcon}" Content="☰" Click="Sidebar_Click" ToolTip="サイドバー" />
          <Button Grid.Column="1" Click="ChatMenu_Click" Background="Transparent" Padding="0" Margin="8,0,12,0" HorizontalContentAlignment="Left" AutomationProperties.Name="チャンネルメニュー"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding ChannelSymbol}" FontSize="23" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0" /><TextBlock x:Name="ChannelTitleText" Text="{Binding ChannelTitle}" FontWeight="SemiBold" FontSize="14" MaxWidth="250" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /></StackPanel></Button>
          <TextBlock x:Name="ChannelDescriptionText" Grid.Column="2" Text="{Binding ChannelDescription}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Button x:Name="InviteButton" Grid.Column="3" Content="招待" Click="InviteMembers_Click" Padding="10,5" Background="Transparent" ToolTip="このチャンネルにメンバーを招待" /><Button x:Name="MembersButton" Grid.Column="4" Click="Members_Click" Style="{StaticResource ShellIcon}" ToolTip="メンバー一覧" AutomationProperties.Name="メンバー一覧"><Path Data="{StaticResource MembersIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Stretch="Uniform" Width="21" Height="21" /></Button>
          <Grid Grid.Column="5" Width="136" Margin="8,9,0,9"><TextBox x:Name="HistorySearchBox" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,3,26,3" AutomationProperties.Name="メッセージを検索" ToolTip="メッセージを検索（Ctrl+F）" /><Path Data="{StaticResource SearchIcon}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" HorizontalAlignment="Right" Margin="0,0,7,0" IsHitTestVisible="False" /><TextBlock Text="検索" Margin="8,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        </Grid></Border>
        <controls:VoiceChannelPanel x:Name="VoicePanel" Grid.Row="1" />
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="MembersColumn" Width="224" /></Grid.ColumnDefinitions>
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="ErrorBanner" Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="4" Margin="16,6,16,0" Padding="12,8" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions><TextBox Text="{Binding Error, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="エラーの詳細" /><Button Grid.Column="1" Content="再試行" Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" /><Button Grid.Column="2" Content="×" Click="DismissError_Click" Style="{StaticResource ShellIcon}" Width="26" Height="26" /></Grid></Border>
            <Grid Grid.Row="1">
<ListBox x:Name="MessagesList" ItemsSource="{Binding Timeline}" Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate>
              <DataTemplate>
                <Border x:Name="MessageBorder" Background="Transparent" Padding="16,5" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AvatarColumn" Width="44" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button Click="Speaker_Click" Padding="0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="プロフィールを表示"><Border x:Name="Avatar" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
                      <TextBlock x:Name="AvatarLetter" Text="{Binding Avatar}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border></Button>
                  <StackPanel Grid.Column="1">
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Grid x:Name="Speaker" VerticalAlignment="Center" Margin="0,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Click="Speaker_Click" Padding="0" Background="Transparent" HorizontalContentAlignment="Left" ToolTip="プロフィールを表示"><TextBlock Text="{Binding Speaker}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" /></Button>


                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,2,0,0" />
                      </Grid>
                      <StackPanel x:Name="MessageActions" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                        <Button Content="↩" ToolTip="この発言へ返信" Style="{StaticResource MessageAction}" Click="ReplyMessage_Click" /><Button Content="⋯" ToolTip="スレッドと発言の操作" Style="{StaticResource MessageAction}" Click="MessageMenu_Click" />
                        <Button Content="コピー" Style="{StaticResource MessageAction}" Click="CopyMessage_Click" />
                        <StackPanel x:Name="AnswerActions" Orientation="Horizontal" IsEnabled="{Binding DataContext.CanEditConversation, RelativeSource={RelativeSource AncestorType=Window}}">


                        </StackPanel>
                        <Button x:Name="EditAction" Content="編集" Style="{StaticResource MessageAction}" Click="EditMessage_Click" Visibility="Collapsed" IsEnabled="{Binding DataContext.CanEditConversation, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </StackPanel>
                    </Grid>
                    <Button Content="{Binding ReplyPreview}" Click="JumpReply_Click" HorizontalContentAlignment="Left" Padding="0,3" FontSize="11" MaxHeight="28" Visibility="{Binding HasReply, Converter={StaticResource BoolVisibility}}" />

                    <TextBlock Text="…" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    <Button Content="{Binding TeamLabel}" Click="TeamActivity_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,6" Visibility="{Binding HasTeam, Converter={StaticResource BoolVisibility}}" /><Button Content="アクティビティを表示" Click="WorkActivity_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,6" Visibility="{Binding HasWork, Converter={StaticResource BoolVisibility}}" />
                    <controls:MarkdownView x:Name="MarkdownBody" PlainText="{Binding IsLocalMessage}" Accounts="{Binding DataContext.MentionAccounts, RelativeSource={RelativeSource AncestorType=Window}}" MentionClicked="MentionLink_Clicked" ReferenceClicked="Reference_Clicked" Markdown="{Binding Content}" TextSize="{Binding DataContext.ChatFontSize, RelativeSource={RelativeSource AncestorType=Window}}" TextLineHeight="{Binding DataContext.ChatLineHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <controls:ComputerTaskPanel Session="{Binding Computer}" />

                    <Button Content="{Binding ArtifactLabel}" Click="OpenArtifact_Click" HorizontalAlignment="Left" Margin="0,6,0,0" BorderBrush="{DynamicResource StrokeBrush}" Visibility="{Binding HasArtifact, Converter={StaticResource BoolVisibility}}" />
                    <Button Content="参考資料" Click="Knowledge_Click" HorizontalAlignment="Left" Padding="8,6" Margin="0,8,0,0" BorderBrush="{DynamicResource StrokeBrush}" Visibility="{Binding HasKnowledge, Converter={StaticResource BoolVisibility}}" ToolTip="この回答の生成時にAIへ渡した抜粋を確認" />


                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate><Button Click="AttachmentPreview_Click" Margin="0,0,8,8" BorderBrush="{DynamicResource StrokeBrush}" ToolTip="添付内容を開く"><StackPanel><Image Source="{Binding Preview}" MaxWidth="220" MaxHeight="150" Stretch="Uniform" /><TextBlock Text="{Binding Label}" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,5,0,0" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasComputer}" Value="True"><Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /></DataTrigger>
                  <DataTrigger Binding="{Binding SearchHighlighted}" Value="True"><Setter TargetName="MessageBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="MessageBorder" Property="BorderThickness" Value="1" /></DataTrigger>
                  <Trigger SourceName="MessageBorder" Property="IsMouseOver" Value="True"><Setter TargetName="MessageBorder" Property="Background" Value="{DynamicResource ChatHoverBrush}" /><Setter TargetName="MessageActions" Property="Opacity" Value="1" /></Trigger>
                  <Trigger SourceName="MessageBorder" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="MessageActions" Property="Opacity" Value="1" /></Trigger>
                  <DataTrigger Binding="{Binding Identity.Detail}" Value="member-joined"><Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" /><Setter TargetName="AvatarColumn" Property="Width" Value="0" /><Setter TargetName="Speaker" Property="Visibility" Value="Collapsed" /><Setter TargetName="MessageActions" Property="Visibility" Value="Collapsed" /><Setter TargetName="MessageBorder" Property="Padding" Value="16,3" /></DataTrigger><DataTrigger Binding="{Binding Role}" Value="user">

                    <Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /><Setter TargetName="EditAction" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsProjection}" Value="True"><Setter TargetName="AnswerActions" Property="Visibility" Value="Collapsed" /><Setter TargetName="EditAction" Property="Visibility" Value="Collapsed" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
</ListBox>
              <Button x:Name="LatestButton" Content="↓ 新しいメッセージ" Click="Latest_Click" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,24,12" Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed" />
              <ScrollViewer x:Name="WelcomeScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="20,32" VerticalAlignment="Bottom"><Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ChatInputBrush}" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="{Binding ChannelSymbol}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding ChannelWelcome}" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="この会話の始まりです。メッセージを送信して会話を始めましょう。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" /><WrapPanel Margin="0,16,0,0"><Button Content="メンバーを招待" Click="InviteMembers_Click" Margin="0,0,8,8" /><Button Content="アカウントを作成" Click="CreateAccount_Click" Margin="0,0,0,8" /></WrapPanel></StackPanel></ScrollViewer>
            </Grid>
            <Grid x:Name="ComposerArea" Grid.Row="2" Margin="16,8,16,0"><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="22" /></Grid.RowDefinitions><Border Background="{DynamicResource ChatInputBrush}" CornerRadius="8" Padding="8,4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Grid.ColumnSpan="3"><Button Content="{Binding ReplyLabel}" Click="ClearReply_Click" Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="4,3" FontSize="11" /><ScrollViewer MaxHeight="52" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding PendingAttachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Margin="0,0,6,4" Padding="4"><StackPanel Orientation="Horizontal"><Button Click="AttachmentPreview_Click" Padding="4,1"><TextBlock Text="{Binding Label}" MaxWidth="180" TextTrimming="CharacterEllipsis" /></Button><Button Content="×" Click="RemoveAttachment_Click" Padding="5,1" ToolTip="添付を外す" IsEnabled="{Binding DataContext.CanChange, RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
              <Button x:Name="AttachButton" Grid.Row="1" Content="⊕" FontSize="25" Click="MediaMenu_Click" Style="{StaticResource ShellIcon}" Padding="0" Width="30" Height="36" VerticalAlignment="Center" ToolTip="ファイルをアップロード" AutomationProperties.Name="ファイルをアップロード" IsEnabled="{Binding CanCompose}" />
              <Grid Grid.Row="1" Grid.Column="1"><TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="150" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4,10" FontSize="14" VerticalContentAlignment="Top" PreviewKeyDown="Input_PreviewKeyDown" AutomationProperties.Name="メッセージを入力" /><TextBlock Text="{Binding ChannelPlaceholder}" Foreground="{DynamicResource MutedBrush}" Margin="4,11,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Input}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="@" Style="{StaticResource ShellIcon}" Click="Mention_Click" ToolTip="メンバーにメンション" AutomationProperties.Name="メンバーにメンション" /><Button Style="{StaticResource ShellIcon}" Click="Emoji_Click" ToolTip="絵文字を選ぶ" AutomationProperties.Name="絵文字を選ぶ"><Path Data="{StaticResource SmileIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform" /></Button><Button Content="■" Command="{Binding StopCommand}" Style="{StaticResource ShellIcon}" ToolTip="進行中の処理を停止" Visibility="{Binding CanStopSelected, Converter={StaticResource BoolVisibility}}" /><Button Command="{Binding SendCommand}" Style="{StaticResource ShellIcon}" ToolTip="{Binding SendLabel}" AutomationProperties.Name="メッセージを送信"><Path Data="{StaticResource SendIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" Width="20" Height="20" Stretch="Uniform" /></Button></StackPanel>
            </Grid></Border><controls:TypingIndicator Grid.Row="1" Text="{Binding TypingNotice}" Margin="4,0" /></Grid>
          </Grid>
          <Border x:Name="MembersPane" Grid.Column="1" Background="{DynamicResource SidebarBrush}" Padding="8,16,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding MemberHeading}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,10" /><Button DockPanel.Dock="Top" Content="＋ メンバーを招待" Click="InviteMembers_Click" HorizontalContentAlignment="Left" Margin="4,0,8,12" Padding="8,6" /><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding RoomMembers}" ItemTemplate="{StaticResource MemberTemplate}" /></ScrollViewer></DockPanel></Border>
        </Grid>
      </Grid>
      <Popup x:Name="MembersPopup" PlacementTarget="{Binding ElementName=MembersButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"><Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Width="224" Padding="6,12" MaxHeight="420"><ItemsControl ItemsSource="{Binding RoomMembers}" ItemTemplate="{StaticResource MemberTemplate}" /></Border></Popup>
    </Grid>
  </Grid>
</Window>
