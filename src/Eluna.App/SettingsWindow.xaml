<Window x:Class="Eluna.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eluna.App.Controls" Style="{StaticResource {x:Type Window}}"
        Title="設定 · Eluna" Width="860" Height="740" MinWidth="560" MinHeight="460" WindowStartupLocation="CenterOwner">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="設定" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
    <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="0" AutomationProperties.Name="設定のカテゴリ">
      <TabItem Header="一般" Style="{StaticResource WorkOptionsTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,16">
            <TextBlock Text="応答を生成する場所" Margin="0,0,0,8" /><ComboBox x:Name="ComputeBox" AutomationProperties.Name="応答を生成する場所" ItemTemplate="{StaticResource ComputeNameTemplate}" />
            <TextBlock Text="自動ではGPUを優先し、利用できない場合はCPUを使います。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20" />
            <TextBlock Text="同時に実行する推論の数" Margin="0,0,0,8" /><ComboBox x:Name="ConcurrencyBox" AutomationProperties.Name="推論の同時実行数" />
            <TextBlock Text="初期値は1です。超えた分は予約し、同じ会話は順番に実行します。複数実行ではモデルを個別に読み込むため、RAM・GPUメモリを多く使います。変更は次の開始から適用します。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20" />
            <TextBlock Text="同時に取得するダウンロードの数" Margin="0,0,0,8" /><ComboBox x:Name="DownloadConcurrencyBox" AutomationProperties.Name="ダウンロードの同時実行数" Margin="0,0,0,16" />
            <TextBlock Text="同時に実行する画像・文書生成の数" Margin="0,0,0,8" /><ComboBox x:Name="MediaConcurrencyBox" AutomationProperties.Name="画像・文書生成の同時実行数" />
            <TextBlock Text="各1〜4件。初期値は1です。チャット推論と独立して実行し、生成ごとにモデルのメモリを使います。実行中の処理は設定を減らしても停止しません。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
            <CheckBox x:Name="ComputerAwakeBox" AutomationProperties.Name="Computer Use中の自動スリープを防ぐ">
              <TextBlock Text="Computer Use中の自動スリープを防ぐ" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="初期値はオンです。実行中と操作の確認待ちは画面とPCを起動状態に保ち、一時停止・終了時に解除します。手動のスリープやロックは防ぎません。変更は次の依頼から適用します。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,20" />
            <TextBlock Text="会話を記憶する長さ（トークン）" Margin="0,0,0,8" /><ComboBox x:Name="ContextBox" AutomationProperties.Name="会話を記憶する長さ（トークン）" />
            <TextBlock Text="長くするとメモリを多く使います。長い会話は元の履歴を残して要約します。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20" />
            <TextBlock Text="表示テーマ" Margin="0,0,0,8" /><ComboBox x:Name="ThemeBox" AutomationProperties.Name="表示テーマ" DisplayMemberPath="Value" Margin="0,0,0,20" />
            <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="文字サイズ" Margin="0,0,0,8" /><ComboBox x:Name="FontBox" AutomationProperties.Name="会話の文字サイズ" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="行の高さ" Margin="0,0,0,8" /><ComboBox x:Name="LineBox" AutomationProperties.Name="会話の行の高さ" /></StackPanel>
            </Grid>
            <TextBlock Text="アプリ全体の文字の拡大" Margin="0,0,0,8" /><ComboBox x:Name="UiScaleBox" AutomationProperties.Name="アプリ全体の文字の拡大" DisplayMemberPath="Value" SelectedValuePath="Key" Margin="0,0,0,16" />
            <CheckBox x:Name="ControlEnterBox" Content="Ctrl+Enterで送信する（Enterは改行）" Margin="0,0,0,20" />
            <TextBlock Text="すべての会話に使うカスタム指示" Margin="0,0,0,8" />
            <TextBox x:Name="InstructionBox" AutomationProperties.Name="すべての会話に使うカスタム指示" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="会話ごとの指示はチャット上部の「⋯」から設定できます。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20" />
            <TextBlock Text="ショートカット: Ctrl+N 新規 / Ctrl+F 履歴検索 / Ctrl+B サイドバー / Esc 停止 / Ctrl+Shift+R 再生成 / Ctrl+Shift+C 回答コピー" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" />
            <Button Content="バージョン・更新内容を確認" Click="Updates_Click" HorizontalAlignment="Left" Margin="0,16,0,0" BorderBrush="{DynamicResource StrokeBrush}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="ライセンス" Style="{StaticResource WorkOptionsTab}">
        <controls:LicensesPanel x:Name="LicenseView" />
      </TabItem>
      <TabItem Header="メモリ" Style="{StaticResource WorkOptionsTab}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="共通の保存メモリです。通常チャットと「共通メモリも使う」プロジェクトで参照します。プロジェクト限定メモリには渡しません。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
          <controls:MemoryEditor x:Name="CommonMemoryEditor" />
        </DockPanel>
      </TabItem>
      <TabItem Header="スキル" Style="{StaticResource WorkOptionsTab}">
        <StackPanel>
          <TextBlock Text="スキル" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="SKILL.mdの手順・参考資料・補助コードを取り込み、依頼に応じて読み込みます。共通とプロジェクトで分離し、限定プロジェクトでは共通スキルを自動で使いません。" TextWrapping="Wrap" Margin="0,0,0,16" />
          <Button Content="スキル管理・取り込みを開く" Click="Skills_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />
          <TextBlock Text="会話ごとの指定と自動適用の切り替えは入力欄の「スキル」から操作します。管理画面の保存はすぐに反映され、予約した依頼は予約時の版を使います。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="管理" Style="{StaticResource WorkOptionsTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="モデルとデータ" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <Button Content="モデルを探す" Click="Models_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="{DynamicResource StrokeBrush}" />
        <Button Content="モデル管理" Click="ManageModels_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="{DynamicResource StrokeBrush}" />
        <Button Content="ダウンロード管理" Click="Downloads_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="{DynamicResource StrokeBrush}" />
        <Button Content="データ・バックアップ" Click="Data_Click" HorizontalContentAlignment="Left" Margin="0,0,0,6" BorderBrush="{DynamicResource StrokeBrush}" />
        <TextBlock Text="進行中の処理と予約順は、メイン画面の「処理リスト」から確認できます。各管理画面を開いたままチャットを利用できます。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="SaveStateText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="保存済み" /><Button Content="保存場所を開く" Click="OpenData_Click" HorizontalAlignment="Left" Padding="0,4" /></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="閉じる" Click="Close_Click" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Content="保存" Click="Save_Click" Padding="24,8" Style="{StaticResource PrimaryButton}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
