<Window x:Class="Eluna.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Eluna.App.Controls" Style="{StaticResource {x:Type Window}}" Title="ユーザー設定 · Eluna" Width="1000" Height="780" MinWidth="660" MinHeight="500" WindowStartupLocation="CenterOwner">
  <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="SettingsTabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" AutomationProperties.Name="設定のカテゴリ">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Background="{DynamicResource SidebarBrush}" Padding="8,24,4,16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ユーザー設定" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,14" /><ScrollViewer VerticalScrollBarVisibility="Auto"><TabPanel IsItemsHost="True" /></ScrollViewer></DockPanel></Border><Border Grid.Column="1" Background="{DynamicResource ChatBackgroundBrush}" Padding="24,24,20,12"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" /></Border></Grid></ControlTemplate></TabControl.Template>
      <TabItem Header="外観・操作" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,16">
        <TextBlock Text="外観・操作" FontSize="22" FontWeight="Bold" Margin="0,0,0,22" />
        <TextBlock Text="テーマ" Margin="0,0,0,8" /><ComboBox x:Name="ThemeBox" DisplayMemberPath="Value" AutomationProperties.Name="表示テーマ" Margin="0,0,0,22" />
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="メッセージの文字サイズ" Margin="0,0,0,8" /><ComboBox x:Name="FontBox" AutomationProperties.Name="会話の文字サイズ" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="行の高さ" Margin="0,0,0,8" /><ComboBox x:Name="LineBox" AutomationProperties.Name="会話の行の高さ" /></StackPanel></Grid>
        <TextBlock Text="アプリ全体の文字の拡大" Margin="0,0,0,8" /><ComboBox x:Name="UiScaleBox" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="アプリ全体の文字の拡大" Margin="0,0,0,22" />
        <CheckBox x:Name="ControlEnterBox" Margin="0,0,0,22"><TextBlock Text="Ctrl+Enterで送信する（Enterは改行）" TextWrapping="Wrap" /></CheckBox>
        <CheckBox x:Name="ReduceMotionBox" AutomationProperties.Name="動きを減らす"><TextBlock Text="動きを減らす" TextWrapping="Wrap" /></CheckBox><TextBlock Text="フェード・押下・ホバー・入力中の動きを停止します。オフの場合もWindowsでアニメーションを無効にしている場合や、高コントラストでは動きを使いません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20" />
        <Button Content="キーボードショートカット · Ctrl+/" Click="Shortcuts_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />
        <TextBlock Text="ショートカット" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBlock Text="Ctrl+N 新規 / Ctrl+F 検索 / Ctrl+B サイドバー / Esc 停止 / Ctrl+Shift+R 再生成 / Ctrl+Shift+C コピー" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
        <Button Content="バージョン・更新内容を確認" Click="Updates_Click" HorizontalAlignment="Left" Margin="0,24,0,0" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="ライセンス" Style="{StaticResource SettingsCategory}"><controls:LicensesPanel x:Name="LicenseView" /></TabItem>
      <TabItem Header="共通メモリ" Style="{StaticResource SettingsCategory}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="共通の保存メモリ" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><TextBlock DockPanel.Dock="Top" Text="通常のDMと共通メモリを許可したサーバーで参照します。限定サーバーには渡しません。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16" /><controls:MemoryEditor x:Name="CommonMemoryEditor" /></DockPanel></TabItem>
      <TabItem Header="スキル" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="スキル" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><TextBlock Text="手順・参考資料・補助コードを管理します。会話ごとの自動適用・指定・オフもここから変更できます。" TextWrapping="Wrap" Margin="0,0,0,18" /><Button Content="スキル管理・取り込みを開く" Click="Skills_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="このチャンネルのスキルを設定" Click="SkillSelection_Click" HorizontalContentAlignment="Left" /><TextBlock Text="{Binding NetworkNotice}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0" /></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="モデル・データ" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="モデルとデータ" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><Button Content="モデルを探す" Click="Models_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="モデル管理" Click="ManageModels_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="ダウンロード管理" Click="Downloads_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="データ・バックアップ" Click="Data_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><TextBlock Text="{Binding SelectedModel.DisplayName}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,8" /><WrapPanel><Button Content="モデルを読み込む" Command="{Binding PreloadCommand}" Margin="0,0,8,0" /><Button Content="モデルをメモリから解放" Command="{Binding UnloadCommand}" /></WrapPanel><TextBlock Text="使用するモデルは「アカウント」で割り当てます。モデルの取得・削除、保存先やバックアップの管理も設定内で行います。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,14,0,0" /></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="アカウント" Style="{StaticResource SettingsCategory}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="アカウント" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><TextBlock DockPanel.Dock="Top" Text="メンバーごとにモデル・話し方・専門分野・記憶を管理します。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16" /><Button DockPanel.Dock="Bottom" Content="アカウントを作成・管理" Click="Accounts_Click" HorizontalAlignment="Left" Margin="0,16,0,0" /><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Agents}"><ItemsControl.ItemTemplate><DataTemplate><Button Click="Account_Click" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}"><TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Specialty}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel><TextBlock Grid.Column="2" Text="編集  ›" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></TabItem>
      <TabItem Header="AI・実行" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,16"><TextBlock Text="AI・実行" FontSize="22" FontWeight="Bold" Margin="0,0,0,22" />
        <TextBlock Text="応答を生成する場所" Margin="0,0,0,8" /><ComboBox x:Name="ComputeBox" ItemTemplate="{StaticResource ComputeNameTemplate}" AutomationProperties.Name="応答を生成する場所" /><TextBlock Text="自動ではGPUを優先し、利用できない場合はCPUを使います。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,22" />
        <TextBlock Text="同時に実行する推論の数" Margin="0,0,0,8" /><ComboBox x:Name="ConcurrencyBox" AutomationProperties.Name="推論の同時実行数" /><TextBlock Text="初期値は1。同じ会話は順番に実行します。複数実行ではRAM・GPUメモリを多く使います。変更は次の開始から適用します。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,22" />
        <TextBlock Text="同時に取得するダウンロードの数" Margin="0,0,0,8" /><ComboBox x:Name="DownloadConcurrencyBox" AutomationProperties.Name="ダウンロードの同時実行数" Margin="0,0,0,22" />
        <TextBlock Text="同時に実行する画像・文書生成の数" Margin="0,0,0,8" /><ComboBox x:Name="MediaConcurrencyBox" AutomationProperties.Name="画像・文書生成の同時実行数" /><TextBlock Text="各1〜4件。実行中の処理は数を減らしても停止しません。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,22" />
        <TextBlock Text="会話を記憶する長さ（トークン）" Margin="0,0,0,8" /><ComboBox x:Name="ContextBox" AutomationProperties.Name="会話を記憶する長さ（トークン）" /><TextBlock Text="長くするとメモリを多く使います。長い会話は元の履歴を残して要約します。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,22" />
        <CheckBox x:Name="ComputerAwakeBox" AutomationProperties.Name="Computer Use中の自動スリープを防ぐ"><TextBlock Text="Computer Use中の自動スリープを防ぐ" TextWrapping="Wrap" /></CheckBox><TextBlock Text="初期値はオン。実行中と操作の確認待ちは画面とPCを起動状態に保ち、一時停止・終了時に解除します。手動のスリープやロックは防ぎません。変更は次の依頼から適用します。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,22" />
        <TextBlock Text="すべての会話に使うカスタム指示" Margin="0,0,0,8" /><TextBox x:Name="InstructionBox" AutomationProperties.Name="すべての会話に使うカスタム指示" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="チャンネル" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,16"><TextBlock Text="チャンネルの設定" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" /><TextBlock x:Name="ChannelScopeText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,18" />
        <TextBlock Text="応答・検索モード" Margin="0,0,0,8" /><ComboBox x:Name="WorkModeBox" ItemTemplate="{StaticResource WorkNameTemplate}" AutomationProperties.Name="作業モード" Margin="0,0,0,18" /><TextBlock Text="思考量" Margin="0,0,0,8" /><ComboBox x:Name="ThinkingBox" DisplayMemberPath="Name" AutomationProperties.Name="思考量" Margin="0,0,0,18" /><TextBlock Text="既定の応答アカウント" Margin="0,0,0,8" /><ComboBox x:Name="SettingRecipientBox" DisplayMemberPath="Name" AutomationProperties.Name="既定の応答アカウント" Margin="0,0,0,18" />
        <TextBlock Text="変更は保存後の依頼に適用します。既に予約した依頼は予約時の設定を使います。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18" /><TextBlock Text="外部通信" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock Text="{Binding NetworkNotice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18" />
        <Button Content="自分のプロフィール" Click="SelfProfile_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="メンバーを招待" Click="InviteMembers_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="検索・調査・議論の設定" Click="WorkOptions_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="チャンネルのアクセス権" Click="Permissions_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="参加者・参照範囲を設定" Click="RoomSettings_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="サーバーの資料・メモリ・指示" Click="ProjectSettings_Click" HorizontalContentAlignment="Left" Margin="0,0,0,18" />
        <TextBlock Text="会話の分岐" Margin="0,0,0,8" /><ComboBox x:Name="BranchSelector" ItemTemplate="{StaticResource BranchNameTemplate}" SelectionChanged="Branch_Changed" Margin="0,0,0,18" />
        <TextBlock Text="この会話のカスタム指示" Margin="0,0,0,8" /><TextBox x:Name="ChannelInstructionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="85" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18" />
        <Button Content="会話の引き継ぎメモを編集" Click="Summary_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="直前の回答を再生成" Click="Regenerate_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="直前の回答の続きを生成" Click="Continue_Click" HorizontalContentAlignment="Left" Margin="0,0,0,18" />
        <TextBlock Text="メッセージの情報" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox x:Name="MessageInfoBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" /><WrapPanel Margin="0,8,0,0"><Button Content="参考資料の抜粋" Click="MessageKnowledge_Click" Margin="0,0,8,0" /><Button Content="使用したスキルの記録" Click="MessageSkills_Click" /></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="画像・文書" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="画像・文書" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><Button Content="画像認識モデルの設定" Click="Vision_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="画像を生成" Click="Image_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="ドキュメントを生成" Click="Document_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" /><Button Content="直前の回答を文書にする" Click="AnswerDocument_Click" HorizontalContentAlignment="Left" /><TextBlock Text="ファイルの添付はメッセージ欄の＋から行えます。生成物は依頼したチャンネルへ表示します。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,18,0,0" /></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="処理リスト" Style="{StaticResource SettingsCategory}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="処理リスト" FontSize="22" FontWeight="Bold" Margin="0,0,0,18" /><ContentControl x:Name="ProcessContent" /><TextBlock Text="このチャンネルの議論" FontWeight="SemiBold" Margin="0,20,0,8" /><controls:DebateTaskPanel x:Name="DiscussionPanel" /><Button Content="調査の活動と資料" Click="WorkActivity_Click" HorizontalAlignment="Left" /><Button Content="この議論の参加者を変更" Click="DiscussionMembers_Click" HorizontalAlignment="Left" Margin="0,8,0,0" /></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SaveStateText" TextWrapping="Wrap" MaxHeight="44" Text="保存済み" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><Button Content="保存場所を開く" Click="OpenData_Click" HorizontalAlignment="Left" Padding="0,4" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="閉じる" Click="Close_Click" Margin="0,0,8,0" /><Button x:Name="SaveButton" Content="変更を保存" Click="Save_Click" Padding="20,8" Style="{StaticResource PrimaryButton}" /></StackPanel></Grid></Border>
  </Grid>
</Window>
