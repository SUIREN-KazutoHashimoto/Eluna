<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="dotnet-platform" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dotnet-platform">
      <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
      <package pattern="Microsoft.NETCore.App.Host.win-x64" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
    </packageSource>
  </packageSourceMapping>
</configuration>
